<Window x:Class="HideYourChat.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HideYourChat Overlay"
        MinWidth="300"
        MinHeight="260"
        Width="480"
        Height="380"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False">

    <Window.Resources>
        <SolidColorBrush x:Key="OverlayBackgroundBrush"
                         Color="#CC111111"/>
        <SolidColorBrush x:Key="MessageCardBackgroundBrush"
                         Color="#33111111"/>
        <SolidColorBrush x:Key="BadgeBackgroundBrush"
                         Color="#DD3A3A3A"/>

        <SolidColorBrush x:Key="PrimaryTextBrush"
                         Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#AAFFFFFF"/>

        <SolidColorBrush x:Key="ControlBackgroundBrush"
                         Color="#AA333333"/>
        <SolidColorBrush x:Key="ControlHoverBackgroundBrush"
                         Color="#BB444444"/>
        <SolidColorBrush x:Key="ControlPressedBackgroundBrush"
                         Color="#CC222222"/>
        <SolidColorBrush x:Key="ControlBorderBrush"
                         Color="#AA666666"/>
        <SolidColorBrush x:Key="ControlFocusedBorderBrush"
                         Color="#CC888888"/>

        <Style TargetType="Button">
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background"
                    Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="8,4"/>
            <Setter Property="Margin"
                    Value="4,0,0,0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource ControlHoverBackgroundBrush}"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                    Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource ControlPressedBackgroundBrush}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                    Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background"
                    Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="10,4"/>
            <Setter Property="CaretBrush"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused"
                                    Value="True">
                                <Setter TargetName="TextBoxBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ControlFocusedBorderBrush}"/>

                                <Setter TargetName="TextBoxBorder"
                                        Property="Background"
                                        Value="{DynamicResource ControlHoverBackgroundBrush}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                    Value="False">
                                <Setter TargetName="TextBoxBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 展开状态 -->
        <Border x:Name="ExpandedPanel"
                Background="{DynamicResource OverlayBackgroundBrush}"
                CornerRadius="14"
                Padding="14"
                Visibility="Visible">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶部栏 -->
                <Grid x:Name="HeaderPanel"
                      Grid.Row="0"
                      Margin="0,0,0,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 拖拽区域 -->
                    <Border x:Name="DragArea"
                            Grid.Column="0"
                            Background="Transparent"
                            MouseLeftButtonDown="DragArea_MouseLeftButtonDown">

                        <DockPanel>
                            <TextBlock Text="HideYourChat"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       DockPanel.Dock="Left"/>

                            <TextBlock x:Name="HeaderStatusText"
                                       Text="交互模式"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="12"
                                       Margin="10,2,0,0"
                                       DockPanel.Dock="Left"/>
                        </DockPanel>
                    </Border>

                    <!-- 操作按钮 -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="折叠"
                                Click="CollapseButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- 消息列表 -->
                <ScrollViewer x:Name="MessageScrollViewer"
                              Grid.Row="1"
                              MinHeight="120"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="MessageScrollViewer_PreviewMouseWheel"
                              ScrollChanged="MessageScrollViewer_ScrollChanged">

                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource MessageCardBackgroundBrush}"
                                        CornerRadius="8"
                                        Padding="8"
                                        Margin="0,0,0,8">

                                    <StackPanel>
                                        <TextBlock FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}">
                                            <Run Text="{Binding SessionName}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding SenderName}"/>
                                        </TextBlock>

                                        <TextBlock Text="{Binding Text}"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 回复区域 -->
                <Grid x:Name="ReplyPanel"
                      Grid.Row="2"
                      Margin="0,12,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="ReplyTextBox"
                             Grid.Row="0"
                             Grid.Column="0"
                             Height="34"
                             VerticalContentAlignment="Center"
                             KeyDown="ReplyTextBox_KeyDown"
                             ToolTip="输入回复内容，按 Enter 发送"
                             TextWrapping="Wrap"/>

                    <Button x:Name="SendButton"
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="70"
                            Height="34"
                            Content="发送"
                            Click="SendButton_Click"/>

                    <TextBlock x:Name="ReplyStatusText"
                               Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="输入内容后按 Enter 或点击发送"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="11"
                               Margin="2,6,0,0"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 折叠状态：圆形悬浮标 -->
        <Grid x:Name="CollapsedRoot"
              Width="72"
              Height="72"
              Visibility="Collapsed"
              MouseLeftButtonDown="CollapsedRoot_MouseLeftButtonDown"
              ToolTip="双击展开，单击拖动">

            <Ellipse Fill="{DynamicResource OverlayBackgroundBrush}"/>

            <TextBlock Text="HYC"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       FontSize="16"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <!-- 未读角标：深灰色，不用明显红色 -->
            <Border x:Name="UnreadBadge"
                    Width="26"
                    Height="20"
                    CornerRadius="10"
                    Background="{DynamicResource BadgeBackgroundBrush}"
                    BorderBrush="#AA666666"
                    BorderThickness="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,-2,-4,0"
                    Visibility="Collapsed">

                <TextBlock x:Name="UnreadBadgeText"
                           Text="0"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</Window>
