<ui:FluentWindow x:Class="HideYourChat.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="HideYourChat"
                 Icon="pack://application:,,,/assets/icons/icon_no_background.png"
                 Width="613"
                 Height="750"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="HideYourChat">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/assets/icons/icon_no_background.png"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1"
              Margin="5,0,5,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:Button x:Name="StartButton"
                       Grid.Column="0"
                       Content="启动监听"
                       Icon="{ui:SymbolIcon Play24}"
                       Appearance="Primary"
                       HorizontalAlignment="Stretch"
                       Height="34"
                       Margin="0,0,4,0"
                       Click="StartButton_Click"/>

            <ui:Button x:Name="StopButton"
                       Content="停止监听"
                       Grid.Column="1"
                       Icon="{ui:SymbolIcon Pause24}"
                       HorizontalAlignment="Stretch"
                       Height="34"
                       Margin="0,0,4,0"
                       Click="StopButton_Click"/>

            <ui:Button Content="显示悬浮窗"
                       Grid.Column="2"
                       Icon="{ui:SymbolIcon Eye24}"
                       HorizontalAlignment="Stretch"
                       Height="34"
                       Margin="0,0,4,0"
                       Click="ShowOverlayButton_Click"/>

            <ui:Button Content="隐藏悬浮窗"
                       Grid.Column="3"
                       Icon="{ui:SymbolIcon EyeOff24}"
                       Height="34"
                       Margin="0,0,4,0"
                       HorizontalAlignment="Stretch"
                       Click="HideOverlayButton_Click"/>

            <!-- === 临时新增：测试更新弹窗，测完删掉 === -->
            <ui:Button x:Name="CheckUpdateButton"
                       Content="检查更新"
                       Grid.Column="4"
                       Icon="{ui:SymbolIcon Alert24}"
                       Height="34"
                       Margin="0,0,4,0"
                       Click="CheckUpdateButton_Click"/>

            <ui:Button x:Name="ToggleThemeButton"
                       Grid.Column="5"
                       Icon="{ui:SymbolIcon WeatherMoon24}"
                       Width="40"
                       Height="34"
                       ToolTip="切换深/浅色主题"
                       Click="ToggleThemeButton_Click"/>
        </Grid>

        <!-- Row 2：查找窗口 -->
        <Grid Grid.Row="2"
              Margin="5,18,5,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- 适配器下拉框 -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,8,0"
                        Grid.Column="0">
                <ui:TextBlock Text="聊天平台"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"/>
                <ComboBox x:Name="AdapterComboBox"
                          Width="160"
                          Height="34"
                          SelectionChanged="AdapterComboBox_SelectionChanged">
                    <ComboBoxItem Content="微信"
                                  IsSelected="True"/>
                    <ComboBoxItem Content="QQ"/>
                </ComboBox>
            </StackPanel>
            <!-- 微信特有:独立窗口配置(只在选微信时显示) -->
            <StackPanel x:Name="StandaloneWindowPanel"
                        Orientation="Horizontal"
                        Grid.Column="1">
                <CheckBox x:Name="StandaloneWindowCheckBox"
                          Content="监听独立聊天窗口"
                          VerticalAlignment="Center"
                          Checked="StandaloneWindowCheckBox_Changed"
                          Unchecked="StandaloneWindowCheckBox_Changed"/>
                <TextBox x:Name="ContactNameBox"
                         Width="160"
                         Height="34"
                         Margin="8,0,0,0"
                         VerticalAlignment="Center"
                         IsEnabled="False"
                         ToolTip="输入独立窗口联系人名称（当前备注）"/>
            </StackPanel>
            <!-- QQ特有：移出和恢复QQ窗口 -->
            <StackPanel x:Name="QQPanel"
                        Orientation="Horizontal"
                        Grid.Column="1"
                        Visibility="Collapsed">
                <ui:TextBlock Text="隐藏方式"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"/>
                <ComboBox x:Name="QQHideModeComboBox"
                          Width="100"
                          Height="34"
                          VerticalAlignment="Center">
                    <ComboBoxItem Content="自动"
                                  IsSelected="True"/>
                    <ComboBoxItem Content="副屏角落"/>
                    <ComboBoxItem Content="屏幕边缘"/>
                </ComboBox>
                <ui:Button x:Name="ToggleQQWindowButton"
                           Content="显示 QQ 窗口"
                           Height="34"
                           Margin="8,0,0,0"
                           Click="ToggleQQWindowButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Row 3：背景透明度 -->
        <Grid Grid.Row="3"
              Margin="5,18,5,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="背景透明度"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

            <Slider x:Name="BackgroundOpacitySlider"
                    Grid.Column="1"
                    Minimum="0.01"
                    Maximum="1"
                    Value="0.80"
                    TickFrequency="0.01"
                    VerticalAlignment="Center"
                    ValueChanged="BackgroundOpacitySlider_ValueChanged"/>

            <TextBlock x:Name="BackgroundOpacityValueText"
                       Grid.Column="2"
                       Text="80%"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"/>
        </Grid>

        <!-- Row 4：文字透明度 -->
        <Grid Grid.Row="4"
              Margin="5,18,5,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="文字透明度"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

            <Slider x:Name="TextOpacitySlider"
                    Grid.Column="1"
                    Minimum="0.01"
                    Maximum="1"
                    Value="1"
                    TickFrequency="0.01"
                    VerticalAlignment="Center"
                    ValueChanged="TextOpacitySlider_ValueChanged"/>

            <TextBlock x:Name="TextOpacityValueText"
                       Grid.Column="2"
                       Text="100%"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"/>
        </Grid>

        <GroupBox x:Name="WeChatCropPanel"
                  Grid.Row="5"
                  Header="微信截图裁剪比例 (0~1，消息区域)"
                  Margin="5,18,5,0">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 4 个比例框 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 试截图按钮 -->
                    <RowDefinition Height="*"/>
                    <!-- 预览图 -->
                </Grid.RowDefinitions>

                <!-- 比例框(沿用已有的那 4 个 NumberBox,整段塞进 Grid.Row=0) -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="左"
                               VerticalAlignment="Center"
                               Margin="0,0,8,8"/>
                    <ui:NumberBox Grid.Row="0"
                                  Grid.Column="1"
                                  x:Name="CropLeftBox"
                                  Minimum="0"
                                  Maximum="1"
                                  SmallChange="0.01"
                                  Margin="0,0,12,8"/>
                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               Text="右"
                               VerticalAlignment="Center"
                               Margin="0,0,8,8"/>
                    <ui:NumberBox Grid.Row="0"
                                  Grid.Column="3"
                                  x:Name="CropRightBox"
                                  Minimum="0"
                                  Maximum="1"
                                  SmallChange="0.01"
                                  Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="上"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ui:NumberBox Grid.Row="1"
                                  Grid.Column="1"
                                  x:Name="CropTopBox"
                                  Minimum="0"
                                  Maximum="1"
                                  SmallChange="0.01"
                                  Margin="0,0,12,0"/>
                    <TextBlock Grid.Row="1"
                               Grid.Column="2"
                               Text="下"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ui:NumberBox Grid.Row="1"
                                  Grid.Column="3"
                                  x:Name="CropBottomBox"
                                  Minimum="0"
                                  Maximum="1"
                                  SmallChange="0.01"
                                  Margin="0,0,0,0"/>
                </Grid>

                <ui:Button Grid.Row="1"
                           x:Name="TryCaptureButton"
                           Content="试截图预览"
                           Icon="{ui:SymbolIcon Camera24}"
                           Height="32"
                           Margin="0,10,0,8"
                           HorizontalAlignment="Left"
                           Click="TryCaptureButton_Click"/>

                <Border Grid.Row="2"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Image x:Name="CropPreviewImage"
                           Stretch="Uniform"
                           StretchDirection="DownOnly"/>
                </Border>
            </Grid>
        </GroupBox>

        <TextBlock x:Name="StatusText"
                   Grid.Row="6"
                   Text="状态：未启动"
                   Margin="5,14,5,5"
                   Foreground="#666666"
                   TextWrapping="Wrap"/>
    </Grid>
</ui:FluentWindow>