<ui:FluentWindow x:Class="HideYourChat.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="HideYourChat"
                 Icon="pack://application:,,,/assets/icons/icon_no_background.png"
                 Width="550"
                 Height="550"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="HideYourChat">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/assets/icons/icon_no_background.png"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ui:NavigationView Grid.Column="0"
                               x:Name="NavView"
                               IsBackButtonVisible="Collapsed"
                               PaneDisplayMode="Left"
                               OpenPaneLength="180"
                               CompactPaneLength="48"
                               IsPaneOpen="False"
                               IsPaneToggleVisible="True">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="主页"
                            Tag="home">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Home24"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="设置"
                            Tag="settings">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Settings24"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.MenuItems>

                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem x:Name="ThemeNavItem"
                                           Content="切换主题"
                                           Tag="theme">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="WeatherMoon24"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>

            <ScrollViewer Grid.Column="1"
                    VerticalScrollBarVisibility="Auto">
                <ContentPresenter x:Name="PageContent"
                        Margin="10,8"/>
            </ScrollViewer>
        </Grid>

        <!-- 底部状态栏 -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Text="状态：就绪"
                   Margin="12,8"
                   Foreground="#666666"
                   TextWrapping="Wrap"/>
    </Grid>
</ui:FluentWindow>