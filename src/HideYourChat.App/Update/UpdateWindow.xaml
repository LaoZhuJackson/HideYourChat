<ui:FluentWindow x:Class="HideYourChat.App.Update.UpdateWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="HideYourChat 更新"
                 Width="460"
                 Height="480"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <ui:TitleBar Grid.Row="0"
                     Title="发现新版本">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/assets/icons/icon_no_background.png"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- 版本信息 -->
        <StackPanel Grid.Row="1"
                    Margin="16,12,16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0"
                              Text="当前版本"
                              VerticalAlignment="Center"/>
                <ui:TextBlock x:Name="CurrentVersionText"
                              Grid.Column="1"
                              Text="1.0.0"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              FontWeight="SemiBold"/>
            </Grid>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0"
                              Text="最新版本"
                              VerticalAlignment="Center"/>
                <ui:TextBlock x:Name="LatestVersionText"
                              Grid.Column="1"
                              Text="v1.0.0"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              FontWeight="Bold"
                              Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/>
            </Grid>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0"
                              Text="文件大小"
                              VerticalAlignment="Center"/>
                <ui:TextBlock x:Name="FileSizeText"
                              Grid.Column="1"
                              Text="0 MB"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>

        <!-- 强制更新提示 -->
        <ui:InfoBar x:Name="ForceUpdateInfoBar"
                    Grid.Row="2"
                    Title="此为强制更新，请立即安装后再使用"
                    Severity="Warning"
                    IsClosable="False"
                    Margin="16,10,16,0"
                    Visibility="Collapsed"/>

        <!-- 更新内容标题 -->
        <ui:TextBlock Grid.Row="3"
                      Text="更新内容"
                      Margin="16,12,16,0"
                      FontWeight="SemiBold"/>

        <!-- 更新内容（可滚动） -->
        <Border Grid.Row="3"
                Margin="16,30,16,0"
                BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <TextBox x:Name="ReleaseNotesBox"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     BorderThickness="0"
                     Background="Transparent"
                     Margin="4"
                     MinHeight="120"/>
        </Border>

        <!-- 不再提醒 -->
        <CheckBox x:Name="DontRemindCheckBox"
                  Grid.Row="4"
                  Content="不再提醒此版本"
                  Margin="16,12,16,0"/>

        <!-- 下载进度条 -->
        <ProgressBar x:Name="DownloadProgressBar"
                     Grid.Row="5"
                     Margin="16,8,16,0"
                     Visibility="Collapsed"/>

        <!-- 按钮 -->
        <Grid Grid.Row="6"
              Margin="16,12,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:TextBlock x:Name="StatusText"
                          Grid.Column="0"
                          Text=""
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/>

            <ui:Button x:Name="SkipButton"
                       Grid.Column="1"
                       Content="跳过此版本"
                       Appearance="Secondary"
                       Margin="0,0,8,0"
                       Click="SkipButton_Click"/>

            <ui:Button x:Name="InstallButton"
                       Grid.Column="2"
                       Content="立即更新"
                       Appearance="Primary"
                       Icon="{ui:SymbolIcon ArrowDownload24}"
                       Click="InstallButton_Click"/>
        </Grid>
    </Grid>
</ui:FluentWindow>