<UserControl x:Class="HideYourChat.App.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,4,0,0">

            <!-- 聊天平台 -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,18">
                <ui:TextBlock Text="聊天平台"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"/>
                <ComboBox x:Name="AdapterComboBox"
                          Width="160"
                          Height="34"
                          SelectionChanged="AdapterComboBox_SelectionChanged">
                    <ComboBoxItem Content="微信"/>
                    <ComboBoxItem Content="QQ"/>
                </ComboBox>
            </StackPanel>

            <!-- 监听控制按钮 (WrapPanel 自动折行) -->
            <WrapPanel Margin="0,0,0,18">
                <ui:Button x:Name="StartButton"
                           Content="启动监听"
                           Icon="{ui:SymbolIcon Play24}"
                           Appearance="Primary"
                           Height="34"
                           Margin="0,0,8,8"
                           Click="StartButton_Click"/>
                <ui:Button x:Name="StopButton"
                           Content="停止监听"
                           Icon="{ui:SymbolIcon Pause24}"
                           Height="34"
                           Margin="0,0,8,8"
                           Click="StopButton_Click"/>
                <ui:Button Content="显示悬浮窗"
                           Icon="{ui:SymbolIcon Eye24}"
                           Height="34"
                           Margin="0,0,8,8"
                           Click="ShowOverlayButton_Click"/>
                <ui:Button Content="隐藏悬浮窗"
                           Icon="{ui:SymbolIcon EyeOff24}"
                           Height="34"
                           Margin="0,0,8,8"
                           Click="HideOverlayButton_Click"/>
            </WrapPanel>

                        <!-- 背景透明度 -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="背景透明度"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <Slider x:Name="BackgroundOpacitySlider"
                        Grid.Column="1"
                        Minimum="0.01"
                        Maximum="1"
                        Value="0.80"
                        TickFrequency="0.01"
                        VerticalAlignment="Center"
                        ValueChanged="BackgroundOpacitySlider_ValueChanged"/>
                <TextBlock x:Name="BackgroundOpacityValueText"
                           Grid.Column="2"
                           Text="80%"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
            </Grid>

            <!-- 文字透明度 -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="文字透明度"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <Slider x:Name="TextOpacitySlider"
                        Grid.Column="1"
                        Minimum="0.01"
                        Maximum="1"
                        Value="1"
                        TickFrequency="0.01"
                        VerticalAlignment="Center"
                        ValueChanged="TextOpacitySlider_ValueChanged"/>
                <TextBlock x:Name="TextOpacityValueText"
                           Grid.Column="2"
                           Text="100%"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
            </Grid>


            <!-- 微信特有：独立窗口配置 -->
            <StackPanel x:Name="StandaloneWindowPanel"
                        Orientation="Horizontal"
                        Margin="0,0,0,18"
                        Visibility="Collapsed">
                <CheckBox x:Name="StandaloneWindowCheckBox"
                          Content="监听独立聊天窗口（按标题查找）"
                          VerticalAlignment="Center"
                          Checked="StandaloneWindowCheckBox_Changed"
                          Unchecked="StandaloneWindowCheckBox_Changed"/>
                <TextBox x:Name="ContactNameBox"
                         Width="180"
                         Height="34"
                         Margin="8,0,0,0"
                         VerticalAlignment="Center"
                         IsEnabled="False"
                         ToolTip="输入独立窗口联系人名称"/>
            </StackPanel>

            <!-- QQ 特有：隐藏方式 + 窗口切换 -->
            <StackPanel x:Name="QQPanel"
                        Orientation="Horizontal"
                        Margin="0,0,0,18"
                        Visibility="Collapsed">
                <ui:TextBlock Text="隐藏方式"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"/>
                <ComboBox x:Name="QQHideModeComboBox"
                          Width="100"
                          Height="34"
                          VerticalAlignment="Center">
                    <ComboBoxItem Content="自动"/>
                    <ComboBoxItem Content="副屏角落"/>
                    <ComboBoxItem Content="屏幕边缘"/>
                </ComboBox>
                <ui:Button x:Name="ToggleQQWindowButton"
                           Content="显示 QQ 窗口"
                           Height="34"
                           Margin="8,0,0,0"
                           Click="ToggleQQWindowButton_Click"/>
            </StackPanel>

            <!-- 微信截图裁剪 -->
            <GroupBox x:Name="WeChatCropPanel"
                      Header="微信截图裁剪比例（消息区域）"
                      Margin="0,0,0,18"
                      Visibility="Collapsed">
                <StackPanel Margin="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="左"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,8"/>
                        <ui:NumberBox Grid.Row="0"
                                      Grid.Column="1"
                                      x:Name="CropLeftBox"
                                      Minimum="0"
                                      Maximum="1"
                                      SmallChange="0.01"
                                      Margin="0,0,12,8"/>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="2"
                                   Text="右"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,8"/>
                        <ui:NumberBox Grid.Row="0"
                                      Grid.Column="3"
                                      x:Name="CropRightBox"
                                      Minimum="0"
                                      Maximum="1"
                                      SmallChange="0.01"
                                      Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="上"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <ui:NumberBox Grid.Row="1"
                                      Grid.Column="1"
                                      x:Name="CropTopBox"
                                      Minimum="0"
                                      Maximum="1"
                                      SmallChange="0.01"
                                      Margin="0,0,12,0"/>
                        <TextBlock Grid.Row="1"
                                   Grid.Column="2"
                                   Text="下"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <ui:NumberBox Grid.Row="1"
                                      Grid.Column="3"
                                      x:Name="CropBottomBox"
                                      Minimum="0"
                                      Maximum="1"
                                      SmallChange="0.01"/>
                    </Grid>
                    <ui:Button x:Name="TryCaptureButton"
                               Content="试截图预览"
                               Icon="{ui:SymbolIcon Camera24}"
                               Height="32"
                               Margin="0,10,0,8"
                               HorizontalAlignment="Left"
                               Click="TryCaptureButton_Click"/>
                    <Border BorderBrush="Gray"
                            BorderThickness="1"
                            CornerRadius="4"
                            MinHeight="100">
                        <Image x:Name="CropPreviewImage"
                               Stretch="Uniform"
                               StretchDirection="DownOnly"
                               MouseLeftButtonDown="CropPreviewImage_MouseLeftButtonDown"/>
                    </Border>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>