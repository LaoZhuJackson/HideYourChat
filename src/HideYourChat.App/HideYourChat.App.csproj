<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\..\assets\icons\icon.ico</ApplicationIcon>
    <Version>1.0.4</Version>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\..\assets\icons\icon_no_background.png">
      <Link>assets\icons\icon_no_background.png</Link>
    </Resource>
    <PackageReference Include="FlaUI.Core" Version="5.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <!-- PaddleOCR 托管层 -->
    <PackageReference Include="Sdcb.PaddleOCR" Version="3.0.1" />
    <!-- 本地离线中文模型(内嵌,免下载) -->
    <PackageReference Include="Sdcb.PaddleOCR.Models.Local" Version="3.0.1" />
    <!-- Windows x64 CPU 原生推理运行时(体积大,几百 MB) -->
    <PackageReference Include="Sdcb.PaddleInference.runtime.win64.mkl" Version="3.0.0.36" />
    <!-- OpenCvSharp 的 Windows 原生运行时(Sdcb.PaddleOCR 依赖 OpenCvSharp,但 native 运行时要显式加) -->
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241107" />
    <PackageReference Include="wpf-ui" Version="4.0.0" />
    <!-- 日志系统 -->
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
  </ItemGroup>
</Project>